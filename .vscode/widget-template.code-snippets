{
	"widgetTemplate": {
		"scope": "typescriptreact",
		"prefix": "widget-template",
		"body": [
			"import { useMemo } from 'react';",
			"",
			"import { useWidget } from '@dashboard/Dashboard';",
			"import { PanelLayout } from '@dashboard/Widget';",
			"import { useWidgetConfig } from '@dashboard/Widget/hooks';",
			"import type { Project } from '@serviceContext/ProjectContext';",
			"import type { AgentId, AgentInfo, AgentType } from '@serviceTypes/agent.type';",
			"import type { DefaultTimeRange } from '@serviceTypes/time.type';",
			"import GridPanel from '@fsd/common/6_shared/components/GridPanel';",
			"",
			"interface WidgetProps {",
				"\ttime: DefaultTimeRange;",
				"\tproject: Project;",
				"\tagents?: {",
				"\t\tagentType: AgentType;",
				"\t\tselectedAgent: Array<AgentId>;",
				"\t};",
				"\tagentInfo?: AgentInfo | null;",
			"}",
			"",
			"const ${1:Widget} = (props: WidgetProps) => {",
				"\treturn <></>;",
			"};",
			"",
			"const WidgetAdaptor = () => {",
				"\tconst { widgetProps, option } = useWidget<'${TM_FILENAME_BASE}'>();",
				"\tconst widgetConfig = useWidgetConfig();",
				"\tconst time = widgetProps.global.time;",
				"\tconst pcode = option.project.pcode;",
				"\tconst project = pcode ? widgetProps.projects.projects[pcode] : null;",
				"\tconst agents = useMemo(() => {",
				"\t\tif (pcode && option.agents.agents) {",
				"\t\t\treturn {",
				"\t\t\t\tselectedAgent: option.agents.agents.id[pcode]?.ids || [],",
				"\t\t\t\tagentType: option.agents.agents.type,",
				"\t\t\t};",
				"\t\t}",
				"",
				"\t\treturn;",
				"\t}, [option]);",
				"\tconst agentInfo = pcode ? widgetProps.agents.agents[pcode] : null;",
				"\tconst title = widgetConfig?.options?.widgetOptions?.title;",
				"",
				"\tif (!time || !project) return <GridPanel deleteHeader loading />;",
				"",
				"\treturn (",
					"\t\t<>",
						"\t\t\t<PanelLayout title={title || '${2:title}'} headerOptions={<></>}>",
							"\t\t\t\t<${1:Widget} time={time} project={project} agents={agents} agentInfo={agentInfo} />",
						"\t\t\t</PanelLayout>",
					"\t\t</>",
				"\t);",
			"};",
			"",
			"export default WidgetAdaptor;",
			"",
		],
		"description": "신규 대시보드 위젯 생성 시 사용할 수 있는 템플릿입니다.",
	}
}